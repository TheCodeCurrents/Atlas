# -------------------------------
# Mark all C files anywhere as C
# -------------------------------
**/*.c linguist-language=C
**/*.h linguist-language=C

# -------------------------------
# Optionally mark assembly files if you have them
# -------------------------------
**/*.s linguist-language=Assembly
**/*.asm linguist-language=Assembly

# -------------------------------
# Nix and Makefile count as their languages
# -------------------------------
**/flake.nix linguist-language=Nix
**/Makefile linguist-language=Makefile

# -------------------------------
# Treat documentation as docs
# -------------------------------
**/*.md linguist-documentation
**/*.typ linguist-documentation
docs/** linguist-documentation